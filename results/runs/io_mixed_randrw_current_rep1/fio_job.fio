; ===========================================================
; FIO Job Configuration - Workload: Mixed 70/30 Read/Write 4k
; Target: Safe disposable file (NOT a raw block device)
; ===========================================================
[global]
filename=C:\Users\anmol\Desktop\Projects\OS Researcg\data\scratch\fio_test.dat
size=512M
time_based=1
runtime=10
ramp_time=2
direct=1
ioengine=sync
group_reporting=1
buffered=0

[mixed_randrw]
rw=randrw
bs=4k
iodepth=32
rwmixread=70
