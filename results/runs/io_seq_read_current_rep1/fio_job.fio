; ===========================================================
; FIO Job Configuration - Workload: Sequential Read 128k
; Target: Safe disposable file (NOT a raw block device)
; ===========================================================
[global]
filename=C:\Users\anmol\Desktop\Projects\OS Researcg\data\scratch\fio_test.dat
size=512M
time_based=1
runtime=10
ramp_time=2
direct=1
ioengine=sync
group_reporting=1
buffered=0

[seq_read]
rw=read
bs=128k
iodepth=16
